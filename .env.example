# Chave da API do provedor do LLM (obrigatoria; provisionada pela UI no primeiro acesso)
OPENAI_API_KEY=

# Modelo (default: gpt-4o-mini — maturidade de tool calling e custo baixo por mensagem)
OPENAI_MODEL=gpt-4o-mini

# Score minimo de similaridade para o RAG de politicas (chunks abaixo sao descartados)
RAG_MIN_SCORE=0.25
